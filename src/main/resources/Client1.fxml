<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.realtimeauctionsystem.controller.ClientController">
    <Label fx:id="statusLabel" layoutX="20" layoutY="20" text="Highest Bid: LKR 5000" />
    <TextArea fx:id="bidHistory" layoutX="20" layoutY="50" prefHeight="200" prefWidth="300" />
    <TextField fx:id="bidField" layoutX="20" layoutY="270" />
    <Button layoutX="200" layoutY="270" text="Place Bid" onAction="#handlePlaceBid" />
</AnchorPane>